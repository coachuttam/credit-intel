  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path, as the code runs it",
      "items": [
        "Ingest (validate, text layer), then locate candidates, then the basis gate, then extract",
        "A page range skips keyword location but is still gated",
        "Only verified fields reach the metrics and rules, which are plain Decimal Python"
      ]
    },
    {
      "dot": "amber",
      "title": "Optional and guard paths",
      "items": [
        "Jev (USE_JEV, off by default) can only remove candidate pages; any doubt, error or missing key sends every page",
        "The send rule runs before any provider is built: held-out is refused; private/ needs a recorded tuning document and the owner's per-run approval",
        "The dry-run tool ingests, locates and gates offline, estimates tokens and cost, and calls no model"
      ]
    },
    {
      "dot": "slate",
      "title": "Outputs",
      "items": [
        "results.json is deterministic; manifest.json is the run record",
        "memo.md is a template, checked against the results before anything is written"
      ]
    }
  ]
