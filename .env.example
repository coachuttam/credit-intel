# Placeholder names only. Never put a real key or value in this file, and never commit a
# real .env (SEC-03). This project does not load .env files: set these in your own shell
# environment, for example `export OPENAI_API_KEY=...` in the terminal you run it from.

# The OpenAI API key (SEC-02). Required for any live call; never written to outputs or logs.
OPENAI_API_KEY=

# Per-run token ceiling (OD-8, NFR-09): required, no default. Overrides config/settings.toml.
CREDIT_INTEL_TOKEN_CEILING=

# Optional overrides of config/settings.toml.
CREDIT_INTEL_LLM_PROVIDER=
CREDIT_INTEL_LLM_MODEL_ID=
CREDIT_INTEL_MAX_OUTPUT_TOKENS=

# Prices in USD per million tokens, entered only after D-02 verification. No defaults.
CREDIT_INTEL_PRICE_INPUT_PER_MILLION=
CREDIT_INTEL_PRICE_OUTPUT_PER_MILLION=

# Set to 1 to run the live tests (tests/live), which call the real API and cost money.
CREDIT_INTEL_LIVE=
